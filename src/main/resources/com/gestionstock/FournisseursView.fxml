<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.FournisseurController"
      spacing="15">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Gestion des Fournisseurs" styleClass="titre"/>

    <HBox spacing="10">
        <VBox spacing="5">
            <Label text="Nom"/>
            <TextField fx:id="champNom" promptText="Nom du fournisseur"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Email"/>
            <TextField fx:id="champEmail" promptText="email@exemple.com"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Téléphone"/>
            <TextField fx:id="champTel" promptText="77XXXXXXX"/>
        </VBox>
    </HBox>

    <HBox spacing="10">
        <Button text="Ajouter" onAction="#ajouterFournisseur"/>
        <Button text="Modifier" onAction="#modifierFournisseur"/>
        <Button text="Supprimer" onAction="#supprimerFournisseur"/>
        <Button text="Vider" onAction="#viderChamps"/>
    </HBox>

    <TableView fx:id="tableFournisseurs" onMouseClicked="#selectionnerFournisseur" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colonneNom" text="Nom" prefWidth="180"/>
            <TableColumn fx:id="colonneEmail" text="Email" prefWidth="200"/>
            <TableColumn fx:id="colonneTel" text="Téléphone" prefWidth="120"/>
            <TableColumn fx:id="colonneNombreProduits" text="Nb. produits" prefWidth="120"/>
        </columns>
    </TableView>

</VBox>