<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.DashboardController"
      spacing="20">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Tableau de bord" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox spacing="15">

        <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
            <Label text="Total Produits" style="-fx-text-fill: #7f8c8d;"/>
            <Label fx:id="labelTotalProduits" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>

        <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
            <Label text="Stock Bas" style="-fx-text-fill: #7f8c8d;"/>
            <Label fx:id="labelStockBas" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
        </VBox>

        <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
            <Label text="Valeur du Stock" style="-fx-text-fill: #7f8c8d;"/>
            <Label fx:id="labelValeurStock" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
        </VBox>

        <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
            <Label text="Mouvements du jour" style="-fx-text-fill: #7f8c8d;"/>
            <Label fx:id="labelMouvementsJour" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
        </VBox>

    </HBox>

    <Label text="⚠ Produits en stock bas" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>

    <TableView fx:id="tableStockBas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colonneNomStockBas" text="Produit" prefWidth="250"/>
            <TableColumn fx:id="colonneStockActuel" text="Stock actuel" prefWidth="150"/>
            <TableColumn fx:id="colonneStockMin" text="Stock minimum" prefWidth="150"/>
        </columns>
    </TableView>

</VBox>