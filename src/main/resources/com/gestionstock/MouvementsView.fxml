<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestionstock.controller.MouvementsController">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>

            <Label text="Gestion des mouvements"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <HBox spacing="10">

                <Button text="Tous"
                        onAction="#afficherTous"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;"/>

                <Button text="Entrées"
                        onAction="#afficherEntrees"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>

                <Button text="Sorties"
                        onAction="#afficherSorties"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>

                <Button text="+ Nouveau Mouvement"
                        onAction="#nouveauMouvement"
                        style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tableMouvements">

            <columns>

                <TableColumn fx:id="colonneDate"
                             text="Date"
                             prefWidth="180"/>

                <TableColumn fx:id="colonneProduit"
                             text="Produit"
                             prefWidth="180"/>

                <TableColumn fx:id="colonneType"
                             text="Type"
                             prefWidth="120"/>

                <TableColumn fx:id="colonneQuantite"
                             text="Quantité"
                             prefWidth="100"/>

                <TableColumn fx:id="colonneMotif"
                             text="Motif"
                             prefWidth="220"/>

            </columns>

            <BorderPane.margin>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </BorderPane.margin>

        </TableView>
    </center>

</BorderPane>