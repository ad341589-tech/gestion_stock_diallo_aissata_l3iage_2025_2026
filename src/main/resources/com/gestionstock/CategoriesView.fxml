<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.CategorieController"
      spacing="15">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Titre -->
    <Label text="Gestion des Catégories"
           styleClass="titre"/>

    <!-- Formulaire -->
    <HBox spacing="10">

        <VBox spacing="5">
            <Label text="Nom"/>
            <TextField fx:id="champNom"
                       promptText="Nom de la catégorie"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Description"/>
            <TextField fx:id="champDescription"
                       promptText="Description"/>
        </VBox>

    </HBox>

    <!-- Boutons -->
    <HBox spacing="10">

        <Button text="Ajouter"
                onAction="#ajouterCategorie"/>

        <Button text="Modifier"
                onAction="#modifierCategorie"/>

        <Button text="Supprimer"
                onAction="#supprimerCategorie"/>

        <Button text="Vider"
                onAction="#viderChamps"/>

    </HBox>

    <!-- Tableau -->
    <TableView fx:id="tableCategories"
               onMouseClicked="#selectionnerCategorie"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="colonneNom"
                         text="Nom"
                         prefWidth="200"/>

            <TableColumn fx:id="colonneDescription"
                         text="Description"
                         prefWidth="350"/>

            <TableColumn fx:id="colonneNombreProduits"
                         text="Nb. produits"
                         prefWidth="150"/>

        </columns>

    </TableView>

</VBox>